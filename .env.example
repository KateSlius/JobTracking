# Copy to .env and fill in. Never commit .env.

# Postgres. Use a London region (e.g. Neon eu-west-2) for UK GDPR.
DATABASE_URL="postgresql://user:password@localhost:5432/uk_job_tracker"

# Auth.js — generate with: npx auth secret
AUTH_SECRET=""

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Resend — https://resend.com/api-keys (used for magic links now, reminders in Phase 4)
AUTH_RESEND_KEY=""
# Must be on a domain verified in Resend. onboarding@resend.dev only delivers to your own Resend account email.
EMAIL_FROM="Job Tracker <onboarding@resend.dev>"
